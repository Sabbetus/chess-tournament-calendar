---
import '../styles/global.css';
import { SUPPORTED_LANGS, langUrl, getTranslations } from '../i18n/index.ts';

export interface Props {
  title?: string;
  description?: string;
  lang?: string;
  currentPath?: string;
  noindex?: boolean;
}
const {
  title = 'Chess Tournament Calendar',
  description = 'Find classical and rapid chess tournaments worldwide. Updated every 12 hours.',
  lang = 'en',
  currentPath = '',
  noindex = false,
} = Astro.props;
const t = getTranslations(lang);
const base = import.meta.env.BASE_URL;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('og-image.png', Astro.site);

const langLabels: Record<string, string> = {
  en: 'EN', es: 'ES', pt: 'PT', de: 'DE', cs: 'CS', fi: 'FI',
};

const pawnIconSvg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><path fill="currentColor" d="M16 4.7c-2.4 0-4.3 1.94-4.3 4.3 0 1.36.64 2.57 1.63 3.36-1.02.5-1.8 1.1-1.8 1.94 0 .58.37 1.05.96 1.44-2.4 1.35-4.09 3.7-4.42 6.46l-.2 1.6h16.26l-.2-1.6c-.33-2.76-2.02-5.11-4.42-6.46.59-.39.96-.86.96-1.44 0-.84-.78-1.44-1.8-1.94.99-.79 1.63-2 1.63-3.36 0-2.36-1.9-4.3-4.3-4.3z"/><rect x="6" y="24.1" width="20" height="3" rx="1.5" fill="currentColor"/></svg>`;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex,follow" />}
  <link rel="canonical" href={canonicalURL} />
  <title>{title}</title>
  <link rel="icon" href={`${base}favicon.ico`} sizes="32x32" />
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <link rel="icon" type="image/png" sizes="48x48" href={`${base}favicon-48x48.png`} />
  <link rel="icon" type="image/png" sizes="96x96" href={`${base}favicon-96x96.png`} />

  <!-- hreflang alternates -->
  {SUPPORTED_LANGS.map(l => (
    <link rel="alternate" hreflang={l} href={`https://chesstournamentcalendar.com${langUrl(l, currentPath)}`} />
  ))}
  <link rel="alternate" hreflang="x-default" href={`https://chesstournamentcalendar.com${currentPath ? `/${currentPath}/` : '/'}`} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:site_name" content="Chess Tournament Calendar" />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Chess Tournament Calendar",
    "url": "https://chesstournamentcalendar.com"
  })} />

  <!-- Auto-redirect to preferred language, from any page. Runs everywhere
       (not just English pages) because a visitor can land directly on a
       mismatched-locale page — e.g. Google ranking and serving our Spanish
       URL to a Finnish-browser visitor for a query neither chose the
       language for. A saved preference (set here, or by clicking the
       language switcher) always wins over the page they happened to land
       on; only first-ever visits fall back to browser-language detection. -->
  <script define:vars={{ currentPath, lang }}>
    (function() {
      function pathFor(target) {
        return target === 'en'
          ? (currentPath ? '/' + currentPath + '/' : '/')
          : (currentPath ? '/' + target + '/' + currentPath + '/' : '/' + target + '/');
      }
      var saved = localStorage.getItem('ctc-lang');
      if (saved) {
        if (saved !== lang) window.location.replace(pathFor(saved));
        return;
      }
      var map = { es:'es', pt:'pt', de:'de', cs:'cs', sk:'cs', fi:'fi' };
      var langs = (navigator.languages || [navigator.language]);
      var detected = 'en';
      for (var i = 0; i < langs.length; i++) {
        var code = langs[i].split('-')[0].toLowerCase();
        if (map[code]) { detected = map[code]; break; }
      }
      localStorage.setItem('ctc-lang', detected);
      if (detected !== lang) window.location.replace(pathFor(detected));
    })();
  </script>

  <!-- Google Analytics — immediate on desktop, deferred on mobile to avoid blocking render -->
  <script>
    (function() {
      var loaded = false;
      function loadGA() {
        if (loaded) return;
        loaded = true;
        var s = document.createElement('script');
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-PME2NXTXQR';
        document.head.appendChild(s);
        window.dataLayer = window.dataLayer || [];
        window.gtag = function(){ window.dataLayer.push(arguments); };
        window.gtag('js', new Date());
        window.gtag('config', 'G-PME2NXTXQR');
      }
      if (window.innerWidth >= 768) {
        loadGA();
      } else {
        setTimeout(loadGA, 3000);
        ['click','scroll','keydown','touchstart'].forEach(function(e) {
          document.addEventListener(e, loadGA, {once: true, passive: true});
        });
      }
    })();
  </script>
</head>
<body>
  <header>
    <div class="header-inner">
      <a href={lang === 'en' ? base : `${base}${lang}/`} class="logo">
        <div class="logo-icon-box" set:html={pawnIconSvg} />
        {currentPath === ''
          ? <h1 class="logo-title">Chess Tournament Calendar</h1>
          : <span class="logo-title">Chess Tournament Calendar</span>}
        <span class="logo-sep">·</span>
        <span class="logo-sub">Chess tournaments worldwide</span>
      </a>
      <nav class="lang-switcher" aria-label="Language">
        {SUPPORTED_LANGS.map(l => (
          <a
            href={langUrl(l, currentPath)}
            class={`lang-link${l === lang ? ' lang-active' : ''}`}
            onclick={`localStorage.setItem('ctc-lang','${l}')`}
            aria-current={l === lang ? 'true' : undefined}
          >{langLabels[l]}</a>
        ))}
      </nav>
    </div>
  </header>
  <main>
    <slot />
  </main>
  <footer>
    <div class="footer-inner">
      <a href={lang === 'en' ? `${base}contact` : `${base}${lang}/contact`} class="footer-contact">{t.footer_contact}</a>
      <p class="footer-partners">{t.footer_partners} <a href="https://chessori.com" target="_blank" rel="noopener">Chessori</a> &amp; <a href="https://nordicchess.fi" target="_blank" rel="noopener">Nordic Chess Festival</a></p>
      <p>{t.footer_data_source} <a href="https://chess-results.com" target="_blank" rel="noopener">chess-results.com</a> {t.footer_data_source_and} <a href="https://ratings.fide.com" target="_blank" rel="noopener">ratings.fide.com</a>. {t.footer_updated}</p>
    </div>
  </footer>
</body>
</html>
