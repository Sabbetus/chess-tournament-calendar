---
import Base from '../../layouts/Base.astro';
import { getTranslations, SUPPORTED_LANGS } from '../../i18n/index.ts';

export function getStaticPaths() {
  return SUPPORTED_LANGS.filter(l => l !== 'en').map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = getTranslations(lang);

const CR = '<a href="https://chess-results.com" target="_blank" rel="noopener">chess-results.com</a>';
const FIDE = '<a href="https://ratings.fide.com" target="_blank" rel="noopener">ratings.fide.com</a>';
const contactHref = `/${lang}/contact`;

const content: Record<string, {
  title: string; lede: string;
  whereTitle: string; whereP: string;
  featuredTitle: string; featuredP: string;
  whoTitle: string; whoP: string;
}> = {
  es: {
    title: 'Acerca de Chess Tournament Calendar',
    lede: 'Averiguar qué torneos de ajedrez se acercan, en cualquier parte del mundo y a cualquier nivel, suele significar revisar varias federaciones a mano. Este sitio lo reúne todo en un solo lugar.',
    whereTitle: 'De dónde vienen los datos',
    whereP: `Los listados de torneos se recopilan automáticamente de ${CR} y ${FIDE}. El sitio se actualiza cada 6 horas. No organizamos ninguno de estos torneos nosotros mismos, ni gestionamos inscripciones o pagos; cada listado enlaza a la página de inscripción o al sitio web propio del torneo cuando existe.`,
    featuredTitle: 'Torneos destacados',
    featuredP: `La mayoría de los listados del sitio se recopilan automáticamente. Un pequeño número se selecciona a mano y se destaca en su lugar, normalmente eventos asociados a los que queremos dar visibilidad extra. Si quieres que tu torneo aparezca destacado, ponte en contacto a través del <a href="${contactHref}">formulario de contacto</a>.`,
    whoTitle: 'Quién está detrás',
    whoP: `Chess Tournament Calendar funciona sin ánimo de lucro desde Finlandia. Puedes escribirnos en cualquier momento a través del <a href="${contactHref}">formulario de contacto</a>.`,
  },
  pt: {
    title: 'Sobre o Chess Tournament Calendar',
    lede: 'Descobrir quais torneios de xadrez estão por vir, em qualquer parte do mundo e em qualquer nível, normalmente significa verificar várias federações manualmente. Este site reúne tudo isso num só lugar.',
    whereTitle: 'De onde vêm os dados',
    whereP: `As listagens de torneios são reunidas automaticamente do ${CR} e do ${FIDE}. O site é atualizado a cada 6 horas. Não organizamos nenhum destes torneios nós mesmos, nem tratamos inscrições ou pagamentos; cada listagem tem um link para a própria página de inscrição ou site do torneio, quando existe.`,
    featuredTitle: 'Torneios em destaque',
    featuredP: `A maioria das listagens do site é reunida automaticamente. Um pequeno número é escolhido manualmente e destacado em vez disso, normalmente eventos parceiros aos quais queremos dar visibilidade extra. Se quiser que o seu torneio seja destacado, entre em contacto através do <a href="${contactHref}">formulário de contacto</a>.`,
    whoTitle: 'Quem administra isto',
    whoP: `O Chess Tournament Calendar funciona sem fins lucrativos, a partir da Finlândia. Pode entrar em contacto connosco a qualquer momento através do <a href="${contactHref}">formulário de contacto</a>.`,
  },
  de: {
    title: 'Über Chess Tournament Calendar',
    lede: 'Herauszufinden, welche Schachturniere anstehen, egal wo auf der Welt und auf welchem Niveau, bedeutet normalerweise, mehrere Verbandsseiten von Hand zu durchsuchen. Diese Seite bringt das alles an einem Ort zusammen.',
    whereTitle: 'Woher die Daten kommen',
    whereP: `Die Turnierlisten werden automatisch von ${CR} und ${FIDE} zusammengestellt. Die Seite wird alle 6 Stunden aktualisiert. Wir organisieren keines dieser Turniere selbst und wickeln auch keine Anmeldungen oder Zahlungen ab; jeder Eintrag verlinkt, sofern vorhanden, auf die eigene Anmeldeseite oder Website des Turniers.`,
    featuredTitle: 'Ausgewählte Turniere',
    featuredP: `Die meisten Einträge auf der Seite werden automatisch zusammengestellt. Eine kleine Anzahl wird stattdessen von Hand ausgewählt und als Featured-Turnier angeheftet, meist Partnerveranstaltungen, denen wir zusätzliche Sichtbarkeit geben möchten. Wenn Sie Ihr Turnier vorstellen lassen möchten, melden Sie sich über das <a href="${contactHref}">Kontaktformular</a>.`,
    whoTitle: 'Wer steht dahinter',
    whoP: `Chess Tournament Calendar wird gemeinnützig aus Finnland betrieben. Sie erreichen uns jederzeit über das <a href="${contactHref}">Kontaktformular</a>.`,
  },
  cs: {
    title: 'O Chess Tournament Calendar',
    lede: 'Zjistit, jaké šachové turnaje se blíží, kdekoli na světě a na jakékoli úrovni, obvykle znamená ručně procházet weby několika federací. Tento web to shromažďuje na jednom místě.',
    whereTitle: 'Odkud pocházejí data',
    whereP: `Seznamy turnajů jsou automaticky získávány z ${CR} a ${FIDE}. Web se aktualizuje každých 6 hodin. Žádný z těchto turnajů sami neorganizujeme a neřešíme přihlášky ani platby; každý záznam odkazuje na vlastní registrační stránku nebo web turnaje, pokud existuje.`,
    featuredTitle: 'Doporučené turnaje',
    featuredP: `Většina záznamů na webu je získávána automaticky. Malý počet je místo toho vybírán ručně a připnut jako doporučený, obvykle partnerské akce, kterým chceme dát větší viditelnost. Pokud chcete, aby byl váš turnaj doporučený, ozvěte se přes <a href="${contactHref}">kontaktní formulář</a>.`,
    whoTitle: 'Kdo to provozuje',
    whoP: `Chess Tournament Calendar je provozován neziskově z Finska. Můžete nás kdykoli kontaktovat přes <a href="${contactHref}">kontaktní formulář</a>.`,
  },
  fi: {
    title: 'Tietoa Chess Tournament Calendar -sivustosta',
    lede: 'Sen selvittäminen, mitä shakkiturnauksia on tulossa, missä päin maailmaa tahansa ja millä tasolla tahansa, tarkoittaa yleensä useiden liittojen sivujen läpikäymistä käsin. Tämä sivusto kokoaa ne kaikki yhteen paikkaan.',
    whereTitle: 'Mistä tiedot tulevat',
    whereP: `Turnauslistaukset kerätään automaattisesti sivustoilta ${CR} ja ${FIDE}. Sivusto päivittyy 6 tunnin välein. Emme järjestä yhtäkään näistä turnauksista itse, emmekä käsittele ilmoittautumisia tai maksuja; jokainen listaus linkittää turnauksen omalle ilmoittautumissivulle tai verkkosivustolle, jos sellainen on olemassa.`,
    featuredTitle: 'Kumppaniturnaukset',
    featuredP: `Suurin osa sivuston listauksista kerätään automaattisesti. Pieni joukko valitaan sen sijaan käsin ja nostetaan esille, yleensä yhteistyötapahtumia, joille haluamme antaa lisänäkyvyyttä. Jos haluat turnauksesi nostettavan esille, ota yhteyttä <a href="${contactHref}">yhteydenottolomakkeen</a> kautta.`,
    whoTitle: 'Kuka tätä ylläpitää',
    whoP: `Chess Tournament Calendar toimii voittoa tavoittelemattomalta pohjalta Suomesta käsin. Voit ottaa yhteyttä milloin tahansa <a href="${contactHref}">yhteydenottolomakkeen</a> kautta.`,
  },
};

const c = content[lang];
---

<Base title={`${t.site_title} — ${c.title}`} description={t.site_description} lang={lang} currentPath="about">
  <h1 class="page-title">{c.title}</h1>

  <div class="prose">
    <p class="lede">{c.lede}</p>

    <h2>{c.whereTitle}</h2>
    <p set:html={c.whereP} />

    <h2>{c.featuredTitle}</h2>
    <p set:html={c.featuredP} />

    <h2>{c.whoTitle}</h2>
    <p set:html={c.whoP} />
  </div>
</Base>
