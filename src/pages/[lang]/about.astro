---
import Base from '../../layouts/Base.astro';
import { getTranslations, SUPPORTED_LANGS } from '../../i18n/index.ts';

export function getStaticPaths() {
  return SUPPORTED_LANGS.filter(l => l !== 'en').map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = getTranslations(lang);

const CR = '<a href="https://chess-results.com" target="_blank" rel="noopener">chess-results.com</a>';
const FIDE = '<a href="https://ratings.fide.com" target="_blank" rel="noopener">ratings.fide.com</a>';
const contactHref = `/${lang}/contact`;

const content: Record<string, {
  title: string; lede: string;
  whereTitle: string; whereP: string;
  upcomingTitle: string; upcomingP: string;
  correctionsTitle: string; correctionsP: string;
  featuredTitle: string; featuredP: string;
  whoTitle: string; whoP: string;
}> = {
  es: {
    title: 'Acerca de Chess Tournament Calendar',
    lede: 'Averiguar qué torneos de ajedrez se acercan, en cualquier parte del mundo y a cualquier nivel, suele significar revisar varias federaciones a mano. Este sitio lo reúne todo en un solo lugar.',
    whereTitle: 'De dónde vienen los datos',
    whereP: `Los listados de torneos se recopilan automáticamente de ${CR}, con datos de clasificación de ${FIDE}. El sitio se actualiza cada 6 horas. No organizamos ninguno de estos torneos nosotros mismos, ni gestionamos inscripciones o pagos; cada listado enlaza a la página de inscripción o al sitio web propio del torneo cuando existe.`,
    upcomingTitle: 'Qué significa "próximo"',
    upcomingP: 'Un torneo permanece en la lista mientras siga apareciendo en los datos. Una sola actualización fallida no lo eliminará del sitio; hacen falta varios fallos consecutivos antes de asumir que ha concluido o se ha cancelado y retirarlo de la lista de próximos torneos.',
    correctionsTitle: 'Correcciones',
    correctionsP: `Este proceso a veces se equivoca: una fecha, una ubicación, un torneo que se ha cancelado sin que nos hayamos dado cuenta todavía. Si detectas un error, o organizas un torneo y quieres que corrijamos algo, usa el <a href="${contactHref}">formulario de contacto</a> y llegará directamente a una persona.`,
    featuredTitle: 'Torneos destacados',
    featuredP: 'La mayoría de los listados del sitio se recopilan automáticamente. Un pequeño número se selecciona a mano y se destaca en su lugar, normalmente eventos asociados a los que queremos dar visibilidad extra.',
    whoTitle: 'Quién está detrás',
    whoP: `Chess Tournament Calendar funciona sin ánimo de lucro desde Finlandia. Puedes escribirnos en cualquier momento a través del <a href="${contactHref}">formulario de contacto</a>.`,
  },
  pt: {
    title: 'Sobre o Chess Tournament Calendar',
    lede: 'Descobrir quais torneios de xadrez estão por vir, em qualquer parte do mundo e em qualquer nível, normalmente significa verificar várias federações manualmente. Este site reúne tudo isso num só lugar.',
    whereTitle: 'De onde vêm os dados',
    whereP: `As listagens de torneios são reunidas automaticamente do ${CR}, com dados de classificação do ${FIDE}. O site é atualizado a cada 6 horas. Não organizamos nenhum destes torneios nós mesmos, nem tratamos inscrições ou pagamentos; cada listagem tem um link para a própria página de inscrição ou site do torneio, quando existe.`,
    upcomingTitle: 'O que significa "próximo"',
    upcomingP: 'Um torneio permanece listado enquanto continuar a aparecer nos dados. Uma única falha não o remove do site; são necessárias várias falhas consecutivas antes de assumirmos que terminou ou foi cancelado e o retirarmos da lista de próximos torneios.',
    correctionsTitle: 'Correções',
    correctionsP: `Este processo às vezes comete erros: uma data, um local, um torneio que foi cancelado sem que tenhamos percebido ainda. Se encontrar um erro, ou organiza um torneio e quer que algo seja corrigido, use o <a href="${contactHref}">formulário de contacto</a> e chegará diretamente a uma pessoa.`,
    featuredTitle: 'Torneios em destaque',
    featuredP: 'A maioria das listagens do site é reunida automaticamente. Um pequeno número é escolhido manualmente e destacado em vez disso, normalmente eventos parceiros aos quais queremos dar visibilidade extra.',
    whoTitle: 'Quem administra isto',
    whoP: `O Chess Tournament Calendar funciona sem fins lucrativos, a partir da Finlândia. Pode entrar em contacto connosco a qualquer momento através do <a href="${contactHref}">formulário de contacto</a>.`,
  },
  de: {
    title: 'Über Chess Tournament Calendar',
    lede: 'Herauszufinden, welche Schachturniere anstehen, egal wo auf der Welt und auf welchem Niveau, bedeutet normalerweise, mehrere Verbandsseiten von Hand zu durchsuchen. Diese Seite bringt das alles an einem Ort zusammen.',
    whereTitle: 'Woher die Daten kommen',
    whereP: `Die Turnierlisten werden automatisch von ${CR} zusammengestellt, mit Wertungsdaten von ${FIDE}. Die Seite wird alle 6 Stunden aktualisiert. Wir organisieren keines dieser Turniere selbst und wickeln auch keine Anmeldungen oder Zahlungen ab; jeder Eintrag verlinkt, sofern vorhanden, auf die eigene Anmeldeseite oder Website des Turniers.`,
    upcomingTitle: 'Was "bevorstehend" bedeutet',
    upcomingP: 'Ein Turnier bleibt gelistet, solange es in den Daten weiterhin auftaucht. Eine einzelne fehlgeschlagene Aktualisierung entfernt ein echtes Turnier nicht von der Seite; es braucht mehrere aufeinanderfolgende Fehlversuche, bevor wir annehmen, dass es beendet oder abgesagt wurde, und es von der Liste kommender Turniere nehmen.',
    correctionsTitle: 'Korrekturen',
    correctionsP: `Bei diesem Prozess passieren manchmal Fehler: ein Datum, ein Ort, ein Turnier, das abgesagt wurde, ohne dass wir es bereits bemerkt haben. Wenn Ihnen ein Fehler auffällt oder Sie ein Turnier veranstalten und etwas korrigiert haben möchten, nutzen Sie das <a href="${contactHref}">Kontaktformular</a>. Es erreicht direkt eine Person.`,
    featuredTitle: 'Ausgewählte Turniere',
    featuredP: 'Die meisten Einträge auf der Seite werden automatisch zusammengestellt. Eine kleine Anzahl wird stattdessen von Hand ausgewählt und als Featured-Turnier angeheftet, meist Partnerveranstaltungen, denen wir zusätzliche Sichtbarkeit geben möchten.',
    whoTitle: 'Wer steht dahinter',
    whoP: `Chess Tournament Calendar wird gemeinnützig aus Finnland betrieben. Sie erreichen uns jederzeit über das <a href="${contactHref}">Kontaktformular</a>.`,
  },
  cs: {
    title: 'O Chess Tournament Calendar',
    lede: 'Zjistit, jaké šachové turnaje se blíží, kdekoli na světě a na jakékoli úrovni, obvykle znamená ručně procházet weby několika federací. Tento web to shromažďuje na jednom místě.',
    whereTitle: 'Odkud pocházejí data',
    whereP: `Seznamy turnajů jsou automaticky získávány z ${CR}, s ratingovými údaji z ${FIDE}. Web se aktualizuje každých 6 hodin. Žádný z těchto turnajů sami neorganizujeme a neřešíme přihlášky ani platby; každý záznam odkazuje na vlastní registrační stránku nebo web turnaje, pokud existuje.`,
    upcomingTitle: 'Co znamená "nadcházející"',
    upcomingP: 'Turnaj zůstává v seznamu, dokud se objevuje v datech. Jediná neúspěšná aktualizace turnaj ze stránky neodstraní; je potřeba několik po sobě jdoucích selhání, než usoudíme, že skončil nebo byl zrušen, a vyřadíme jej ze seznamu nadcházejících turnajů.',
    correctionsTitle: 'Opravy',
    correctionsP: `Tento proces se občas splete: datum, místo, turnaj, který byl zrušen, aniž bychom si toho ještě všimli. Pokud najdete chybu, nebo pořádáte turnaj a chcete něco opravit, použijte <a href="${contactHref}">kontaktní formulář</a>, který se dostane přímo k člověku.`,
    featuredTitle: 'Doporučené turnaje',
    featuredP: 'Většina záznamů na webu je získávána automaticky. Malý počet je místo toho vybírán ručně a připnut jako doporučený, obvykle partnerské akce, kterým chceme dát větší viditelnost.',
    whoTitle: 'Kdo to provozuje',
    whoP: `Chess Tournament Calendar je provozován neziskově z Finska. Můžete nás kdykoli kontaktovat přes <a href="${contactHref}">kontaktní formulář</a>.`,
  },
  fi: {
    title: 'Tietoa Chess Tournament Calendar -sivustosta',
    lede: 'Sen selvittäminen, mitä shakkiturnauksia on tulossa, missä päin maailmaa tahansa ja millä tasolla tahansa, tarkoittaa yleensä useiden liittojen sivujen läpikäymistä käsin. Tämä sivusto kokoaa ne kaikki yhteen paikkaan.',
    whereTitle: 'Mistä tiedot tulevat',
    whereP: `Turnauslistaukset kerätään automaattisesti sivustolta ${CR}, ja ratingtiedot tulevat sivustolta ${FIDE}. Sivusto päivittyy 6 tunnin välein. Emme järjestä yhtäkään näistä turnauksista itse, emmekä käsittele ilmoittautumisia tai maksuja; jokainen listaus linkittää turnauksen omalle ilmoittautumissivulle tai verkkosivustolle, jos sellainen on olemassa.`,
    upcomingTitle: 'Mitä "tuleva" tarkoittaa',
    upcomingP: 'Turnaus pysyy listalla niin kauan kuin se näkyy taustalla olevassa datassa. Yksittäinen epäonnistunut päivitys ei poista todellista turnausta sivustolta; tarvitaan useita peräkkäisiä epäonnistumisia ennen kuin oletamme sen päättyneen tai peruuntuneen ja poistamme sen tulevien turnausten listalta.',
    correctionsTitle: 'Korjaukset',
    correctionsP: `Tässä prosessissa tulee joskus virheitä: väärä päivämäärä, paikka, tai turnaus, joka on peruttu ilman että olemme vielä huomanneet sitä. Jos huomaat virheen, tai järjestät turnauksen ja haluat jotain korjattavaksi, käytä <a href="${contactHref}">yhteydenottolomaketta</a>, niin viesti tavoittaa suoraan oikean henkilön.`,
    featuredTitle: 'Kumppaniturnaukset',
    featuredP: 'Suurin osa sivuston listauksista kerätään automaattisesti. Pieni joukko valitaan sen sijaan käsin ja nostetaan esille, yleensä yhteistyötapahtumia, joille haluamme antaa lisänäkyvyyttä.',
    whoTitle: 'Kuka tätä ylläpitää',
    whoP: `Chess Tournament Calendar toimii voittoa tavoittelemattomalta pohjalta Suomesta käsin. Voit ottaa yhteyttä milloin tahansa <a href="${contactHref}">yhteydenottolomakkeen</a> kautta.`,
  },
};

const c = content[lang];
---

<Base title={`${t.site_title} — ${c.title}`} description={t.site_description} lang={lang} currentPath="about">
  <h1 class="page-title">{c.title}</h1>

  <div class="prose">
    <p class="lede">{c.lede}</p>

    <h2>{c.whereTitle}</h2>
    <p set:html={c.whereP} />

    <h2>{c.upcomingTitle}</h2>
    <p>{c.upcomingP}</p>

    <h2>{c.correctionsTitle}</h2>
    <p set:html={c.correctionsP} />

    <h2>{c.featuredTitle}</h2>
    <p>{c.featuredP}</p>

    <h2>{c.whoTitle}</h2>
    <p set:html={c.whoP} />
  </div>
</Base>
